SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.development
SDKWORK_MUSIC_ENVIRONMENT=development
SDKWORK_MUSIC_DEPLOYMENT_PROFILE=cloud
SDKWORK_MUSIC_PROFILE_ID=cloud.development
SDKWORK_MUSIC_APPLICATION_PUBLIC_HTTP_URL=https://music-dev.sdkwork.com;https://music-dev.birdcoder.com;https://music-dev.dtupay.com;https://music-dev.skubc.com;https://music-dev.zowalk.com;https://music-dev.offer86.com;https://music-dev.86offer.com
VITE_SDKWORK_MUSIC_APPLICATION_PUBLIC_HTTP_URL=https://music-dev.sdkwork.com;https://music-dev.birdcoder.com;https://music-dev.dtupay.com;https://music-dev.skubc.com;https://music-dev.zowalk.com;https://music-dev.offer86.com;https://music-dev.86offer.com
SDKWORK_MUSIC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com;https://api-dev.birdcoder.com;https://api-dev.dtupay.com;https://api-dev.skubc.com;https://api-dev.zowalk.com;https://api-dev.offer86.com;https://api-dev.86offer.com
VITE_SDKWORK_MUSIC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com;https://api-dev.birdcoder.com;https://api-dev.dtupay.com;https://api-dev.skubc.com;https://api-dev.zowalk.com;https://api-dev.offer86.com;https://api-dev.86offer.com
SDKWORK_MUSIC_RUNTIME_TARGET=browser

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MUSIC_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
